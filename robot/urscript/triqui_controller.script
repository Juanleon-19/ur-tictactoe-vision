# UR Tic-Tac-Toe V1 controller
# Taught-feature motion integrated; full controller acceptance pending.
# Use the validated Installation/TCP, known initial state and physical stop.
# A raised destination alone does not certify the joint transfer path.

def triqui_controller():
  # Existing V1 Modbus contract. Do not add registers here.
  global COMMAND_REGISTER = 128
  global STATUS_REGISTER = 129
  global COMMAND_IDLE = 0
  global STATUS_READY = 0
  global STATUS_BUSY = 1
  global STATUS_DONE = 2
  global STATUS_ERROR = 3

  # 0 = NO MOTION, 1 = SAFE GRID ONLY, 2 = PICK AND PLACE.
  global MOTION_MODE = 0

  # CB3 / PolyScope 3.14: Assignment Nodes must supply these base-frame poses:
  # P1, P3, P7, P9 (actual placement), P_PICK (pickup), P_HOME (HOME/WAIT).
  # No feature symbols are resolved here. Re-run Assignments after reteaching.
  # Include the installed Robotiq URCap definitions in the PolyScope program.
  # +Tool Z lowers this validated TCP; -Tool Z raises it by 40 mm.
  global APPROACH_DZ = -0.040
  global JOINT_A = 0.20
  global JOINT_V = 0.10
  global LINEAR_A = 0.05
  global LINEAR_V = 0.02
  global gripper_initialized = False

  def interpolated_cell_pose(cell):
    local row = floor((cell - 1) / 3)
    local col = (cell - 1) - row * 3
    local u = col / 2.0
    local v = row / 2.0
    local x = (1-u)*(1-v)*P1[0] + u*(1-v)*P3[0] + (1-u)*v*P7[0] + u*v*P9[0]
    local y = (1-u)*(1-v)*P1[1] + u*(1-v)*P3[1] + (1-u)*v*P7[1] + u*v*P9[1]
    local z = (1-u)*(1-v)*P1[2] + u*(1-v)*P3[2] + (1-u)*v*P7[2] + u*v*P9[2]
    return p[x, y, z, P1[3], P1[4], P1[5]]
  end

  # Mode0 does not evaluate any pose or initialize/operate the gripper.
  if ((MOTION_MODE == 1) or (MOTION_MODE == 2)):
    global P2 = interpolated_cell_pose(2)
    global P4 = interpolated_cell_pose(4)
    global P5 = interpolated_cell_pose(5)
    global P6 = interpolated_cell_pose(6)
    global P8 = interpolated_cell_pose(8)
    # Preserve corner XYZ, normalize their orientation to P1 too.
    global P3 = interpolated_cell_pose(3)
    global P7 = interpolated_cell_pose(7)
    global P9 = interpolated_cell_pose(9)
  end

  def selected_cell_pose(cell):
    if (cell == 1):
      return P1
    elif (cell == 2):
      return P2
    elif (cell == 3):
      return P3
    elif (cell == 4):
      return P4
    elif (cell == 5):
      return P5
    elif (cell == 6):
      return P6
    elif (cell == 7):
      return P7
    elif (cell == 8):
      return P8
    elif (cell == 9):
      return P9
    else:
      textmsg("Invalid CELL", cell)
      halt
    end
  end

  def gripper_initialize():
    # Activate only on the first Mode2 cycle of this program execution.
    if (gripper_initialized == False):
      rq_activate_and_wait()
      global gripper_initialized = True
    end
  end

  def move_to_cell_safe(cell):
    local Pn = selected_cell_pose(cell)
    local Pn_UP = pose_trans(Pn, p[0,0,APPROACH_DZ,0,0,0])
    textmsg("SAFE GRID cell", cell)
    textmsg("SAFE GRID pose", Pn_UP)
    movej(get_inverse_kin(Pn_UP), a=JOINT_A, v=JOINT_V)
    return True
  end

  def prepare_pick_and_place(cell):
    if ((cell < 1) or (cell > 9) or (cell != floor(cell))):
      textmsg("Invalid CELL", cell)
      return False
    end
    local P_PICK_UP = pose_trans(P_PICK, p[0,0,APPROACH_DZ,0,0,0])
    gripper_initialize()
    rq_open_and_wait()
    movej(get_inverse_kin(P_PICK_UP), a=JOINT_A, v=JOINT_V)
    movel(P_PICK, a=LINEAR_A, v=LINEAR_V)
    rq_close_and_wait()
    movel(P_PICK_UP, a=LINEAR_A, v=LINEAR_V)
    local Pn = selected_cell_pose(cell)
    local Pn_UP = pose_trans(Pn, p[0,0,APPROACH_DZ,0,0,0])
    movej(get_inverse_kin(Pn_UP), a=JOINT_A, v=JOINT_V)
    movel(Pn, a=LINEAR_A, v=LINEAR_V)
    rq_open_and_wait()
    movel(Pn_UP, a=LINEAR_A, v=LINEAR_V)
    movej(get_inverse_kin(P_HOME), a=JOINT_A, v=JOINT_V)
    return True
  end

  def execute_cell(cell):
    if (MOTION_MODE == 0):
      textmsg("NO MOTION - CELL", cell)
      # Keep BUSY externally observable without performing any physical action.
      sleep(0.1)
      return True
    elif (MOTION_MODE == 1):
      return move_to_cell_safe(cell)
    elif (MOTION_MODE == 2):
      return prepare_pick_and_place(cell)
    else:
      textmsg("Invalid MOTION_MODE", MOTION_MODE)
      return False
    end
  end

  global controller_status = STATUS_READY
  write_port_register(STATUS_REGISTER, controller_status)
  textmsg("Triqui controller ready; MOTION_MODE", MOTION_MODE)

  while (True):
    local command = read_port_register(COMMAND_REGISTER)

    if ((command < 0) or (command > 9)):
      if (controller_status != STATUS_ERROR):
        controller_status = STATUS_ERROR
        write_port_register(STATUS_REGISTER, controller_status)
        textmsg("Invalid COMMAND", command)
      end
    elif (controller_status == STATUS_READY):
      if (command == COMMAND_IDLE):
        # Remain READY.
      else:
        controller_status = STATUS_BUSY
        write_port_register(STATUS_REGISTER, controller_status)
        textmsg("BUSY CELL", command)
        if (execute_cell(command)):
          controller_status = STATUS_DONE
        else:
          controller_status = STATUS_ERROR
        end
        write_port_register(STATUS_REGISTER, controller_status)
      end
    elif (controller_status == STATUS_DONE):
      if (command == COMMAND_IDLE):
        controller_status = STATUS_READY
        write_port_register(STATUS_REGISTER, controller_status)
      end
      # A nonzero command is intentionally ignored to prevent duplicate motion.
    elif (controller_status == STATUS_ERROR):
      if (command == COMMAND_IDLE):
        controller_status = STATUS_READY
        write_port_register(STATUS_REGISTER, controller_status)
      end
      # Clear ERROR with COMMAND=0 before accepting another cell.
    end

    sleep(0.05)
  end
end

triqui_controller()
